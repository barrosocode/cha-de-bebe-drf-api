# Copie este arquivo para .env e preencha os valores. Não commite o .env.
#
# A URI do session pooler não é uma variável. Ela se divide nos campos abaixo:
# postgresql://postgres.<PROJECT-REF>:<SENHA>@<HOST>:5432/postgres

DB_USER=postgres.<PROJECT-REF>
DB_PASSWORD=
DB_HOST=aws-0-<regiao>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# Storage S3 do Supabase. A secret fica só no .env e no Render.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION_NAME=sa-east-1
SUPABASE_S3_BUCKET_NAME=images
SUPABASE_S3_CUSTOM_DOMAIN=<project-ref>.supabase.co/storage/v1/object/public/images
